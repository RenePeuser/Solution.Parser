<Window x:Class="SampleApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SampleApp.Wpf.Views"
        xmlns:vm="clr-namespace:SampleApp.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Height="450"
        Width="800">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Style="{StaticResource CaptionText}" Text="Search:" />
            <TextBox x:Name="SearchBox"
                     Width="220"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filters the list below: type a name" />
            <TextBlock Margin="12,0,0,0"
                       Text="{Binding PersonCount, StringFormat={}{0:N0} people}" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Margin="0,12"
                 ItemsSource="{Binding People}"
                 SelectedItem="{Binding SelectedPerson}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PersonViewModel}">
                    <views:PersonView />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <TextBlock Margin="0,0,12,0"
                       Foreground="{StaticResource ErrorBrush}"
                       Text="{Binding ErrorMessage}" />
            <Button x:Name="SaveButton"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy}"
                    Style="{StaticResource PrimaryButton}">Save</Button>
        </StackPanel>
    </Grid>
</Window>
