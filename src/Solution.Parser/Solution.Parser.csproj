<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Authors>Rene Peuser</Authors>
        <Company>Rene Peuser Softwaresolutions</Company>
        <Description>This is a lightweight abstraction around the Roslyn C# syntax tress. Main goal for easy code rule tests.</Description>
        <Copyright>Copyright 2022 (c) Rene Peuser. All rights reserved.</Copyright>
        <PackageProjectUrl>https://renepeuser.visualstudio.com/Solution.Parser</PackageProjectUrl>
        <RepositoryUrl>https://renepeuser.visualstudio.com/Solution.Parser</RepositoryUrl>
        <PackageReleaseNotes>Breaking: member lists now hold only the members a type declares itself; use AllTypes(), DescendantTypes() and AllMethods() for the recursive walk. Class, Struct, Record, Interface and Enum are now siblings below TypeDeclaration with a TypeKind. Declarations carry Location, Accessibility, XML documentation and type parameters. Delegates, indexers, operators and finalizers are parsed. Fixes: fully qualified names under a file scoped or nested namespace, SyntaxTree returning the whole file, only the first variable of a shared field declaration, missing modifiers such as sealed, virtual, override, new and async, IsNullable on a nullable type argument, IsReadOnly decided by text search, and line splitting on the platform line ending.</PackageReleaseNotes>
        <PackageTags>C#;Solution;Project;XAML;SyntaxTree;Syntax;slnx</PackageTags>
        <PackageId>Solution.Parser</PackageId>
        <OutputType>Library</OutputType>
        <AssemblyName>Solution.Parser</AssemblyName>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <PackageLicenseFile>License.txt</PackageLicenseFile>
    </PropertyGroup>

    <!--Property group settings for source link !-->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DocumentationFile>.\Solution.Parser.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NuGet.Configuration" Version="7.3.0" />
        <PackageReference Include="NuGet.Versioning" Version="7.3.0" />
        <PackageReference Include="Extensions.Pack" Version="7.0.0" />
        <PackageReference Include="FileSystem.Abstraction" Version="0.1.2" />
        <PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Build" Version="18.4.0" />
        <!-- Required at runtime by Microsoft.Build to parse the xml based slnx solution format. Microsoft.Build does not declare it as dependency. -->
        <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageReference Include="Microsoft.SourceLink.AzureRepos.Git" Version="10.0.401" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\License.txt">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>
