<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Authors>Rene Peuser</Authors>
        <Company>Rene Peuser Softwaresolutions</Company>
        <Description>This is a lightweight abstraction around the Roslyn C# syntax tress. Main goal for easy code rule tests.</Description>
        <Copyright>Copyright 2022 (c) Rene Peuser. All rights reserved.</Copyright>
        <PackageProjectUrl>https://renepeuser.visualstudio.com/Solution.Parser</PackageProjectUrl>
        <RepositoryUrl>https://renepeuser.visualstudio.com/Solution.Parser</RepositoryUrl>
        <PackageReleaseNotes>Upgrade to .Net 10</PackageReleaseNotes>
        <PackageTags>C#;Solution;Project;XAML;SyntaxTree;Syntax</PackageTags>
        <PackageId>Solution.Parser</PackageId>
        <OutputType>Library</OutputType>
        <AssemblyName>Solution.Parser</AssemblyName>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <PackageLicenseFile>License.txt</PackageLicenseFile>
    </PropertyGroup>

    <!--Property group settings for source link !-->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DocumentationFile>.\Solution.Parser.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NuGet.Configuration" Version="7.3.0" />
        <PackageReference Include="NuGet.Versioning" Version="7.3.0" />
        <PackageReference Include="Extensions.Pack" Version="7.0.0-alpha.28" />
        <PackageReference Include="FileSystem.Abstraction" Version="0.1.2" />
        <PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Build" Version="18.4.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageReference Include="Microsoft.SourceLink.AzureRepos.Git" Version="10.0.201" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\License.txt">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>
