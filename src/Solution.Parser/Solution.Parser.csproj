<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <Nullable>enable</Nullable>
        <Authors>Rene Peuser</Authors>
        <Company>Rene Peuser Softwaresolutions</Company>
        <Description>
            WIP - This simple SDK to parse solution, projects and c# files
        </Description>
        <Copyright>Copyright 2022 (c) Rene Peuser. All rights reserved.</Copyright>
        <PackageProjectUrl>https://renepeuser.visualstudio.com/Solution.Parser</PackageProjectUrl>
        <RepositoryUrl>https://renepeuser.visualstudio.com/Solution.Parser</RepositoryUrl>
        <PackageReleaseNotes>Alpha release - WIP - Currently only for Net6</PackageReleaseNotes>
        <PackageTags>C#;Solution;Project;XAML:SyntaxTree;Syntax</PackageTags>
        <PackageId>SolutionParser</PackageId>
        <OutputType>Library</OutputType>
        <AssemblyName>SolutionParser</AssemblyName>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <PackageLicenseFile>License.txt</PackageLicenseFile>
    </PropertyGroup>

    <!--Property group settings for source link !-->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DocumentationFile>.\SolutionParser.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Argument.Check" Version="2.0.0-alpha.52" />
        <PackageReference Include="Extensions.Pack" Version="1.1.0-alpha.8" />
        <PackageReference Include="FileSystem.Abstraction" Version="0.1.2" />
        <PackageReference Include="GitVersion.MsBuild" Version="5.10.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Build" Version="17.1.0" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.1.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.1.0" />
        <PackageReference Include="Microsoft.SourceLink.AzureRepos.Git" Version="1.1.1" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\License.txt">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\README.md">
          <Pack>True</Pack>
          <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>
