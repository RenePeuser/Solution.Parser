<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The one package that ships. The split into Solution.Parser.Core, .CSharp, .Xaml, .Nuspec,
      .Project, .Sln and .AspNet is internal organisation only: their assemblies are packed into this
      package, and none of them is published on its own. An existing
      <PackageReference Include="Solution.Parser" /> therefore keeps working unchanged.

      To publish them separately later, set IsPackable back to true on those projects and drop the
      PrivateAssets on the project references below; the package would then turn into a meta package
      that depends on them.
    -->
    <PropertyGroup>
        <Description>Lightweight abstractions over C# syntax trees, XAML markup, csproj, sln and nuspec files. Main goal for easy code rule tests.</Description>
        <PackageTags>C#;Solution;Project;XAML;WPF;SyntaxTree;Syntax;slnx;CodeRules</PackageTags>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

        <!--
          The project carries no code of its own, so its own assembly is an empty one. It is packed
          all the same, so that the assembly identity Solution.Parser keeps existing, and the
          assemblies of the referenced projects are added next to it by the target below.
        -->
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AddReferencedAssembliesToPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <PropertyGroup>
        <PackageReleaseNotes>Major release with breaking changes. Full migration guide in MIGRATION.md. New: .NET 10 support, slnx solution format, Location on all declarations (clickable path(line,column)), complete modifier support (sealed/virtual/override/async), indexers/operators/finalizers, XML documentation, TypeKind, better XAML element tree. Breaking: Namespaces renamed (XAML→Xaml, Solution→Sln, Common→Core), member lists now non-recursive (use AllTypes()/AllMethods()), type hierarchy changed (Class/Record/Struct/Interface are siblings), XAML Controls→Children, project.CSharpFileInfos→SourceFiles.CSharpFiles(). Fixes: SyntaxTree scope, shared field declarations, IsNullable/IsReadOnly/IsAsync accuracy, XAML Parent/nesting/property elements.</PackageReleaseNotes>
    </PropertyGroup>

    <!--
      PrivateAssets keeps these out of the package as dependencies, because their assemblies travel
      inside the package instead.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Solution.Parser.Core\Solution.Parser.Core.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Solution.Parser.CSharp\Solution.Parser.CSharp.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Solution.Parser.CSharp.Semantic\Solution.Parser.CSharp.Semantic.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Solution.Parser.Xaml\Solution.Parser.Xaml.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Solution.Parser.Nuspec\Solution.Parser.Nuspec.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Solution.Parser.Project\Solution.Parser.Project.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Solution.Parser.Sln\Solution.Parser.Sln.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Solution.Parser.AspNet\Solution.Parser.AspNet.csproj" PrivateAssets="all" />
    </ItemGroup>

    <!--
      The third party dependencies of the referenced projects. PrivateAssets above cuts off the
      transitive flow, so they are declared here to stay dependencies of the package. Keep in sync
      when a referenced project gains or drops a PackageReference; PackageDependencyTest guards it.
    -->
    <ItemGroup>
        <PackageReference Include="Extensions.Pack" Version="7.0.0" />
        <PackageReference Include="FileSystem.Abstraction" Version="0.1.2" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageReference Include="Microsoft.Build" Version="18.4.0" />
        <!-- Required at runtime by Microsoft.Build to parse the xml based slnx solution format. Microsoft.Build does not declare it as dependency. -->
        <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
        <PackageReference Include="NuGet.Configuration" Version="7.3.0" />
        <PackageReference Include="NuGet.Versioning" Version="7.3.0" />
    </ItemGroup>

    <Target Name="AddReferencedAssembliesToPackage" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <_ReferencedAssembly Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))"
                                 Condition="'%(Extension)' == '.dll'" />

            <BuildOutputInPackage Include="@(_ReferencedAssembly)" />

            <!--
              The documentation files are not on ReferenceCopyLocalPaths, so they are derived from the
              assembly paths. Without them a consumer loses IntelliSense on everything but the empty
              Solution.Parser assembly.
            -->
            <BuildOutputInPackage Include="@(_ReferencedAssembly->'%(RootDir)%(Directory)%(Filename).xml')"
                                  Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" />
        </ItemGroup>
    </Target>

</Project>
