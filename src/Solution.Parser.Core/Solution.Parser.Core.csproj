<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Shared contracts and helpers for the Solution.Parser packages. Referenced by the other packages rather than used on its own.</Description>
        <PackageTags>Solution;Parser;CodeRules</PackageTags>
        <!-- Shipped inside the Solution.Parser package, not published on its own. -->
        <IsPackable>false</IsPackable>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Extensions.Pack" />
        <PackageReference Include="FileSystem.Abstraction" />
    </ItemGroup>

</Project>
